      "Highlight": {
        "Text": "\u57CE\u5E02\u4E0D\u518D\u662F\u6C99\u76D8\uFF0C\u800C\u662F\u4F1A\u53CD\u6297\u7684\u5BF9\u624B\uFF0C\u98A0\u8986\u4F60\u5BF9\u5EFA\u9020\u6E38\u620F\u7684\u9884\u671F"
      },
      "Description": "\u8FD9\u6E38\u620F\u540D\u5B57\u5C31\u5F88\u76F4\u767D\uFF0C\u57CE\u5E02\u5EFA\u9020\u6E38\u620F\uFF0C\u4F46\u57CE\u5E02\u4E0D\u5E0C\u671B\u4F60\u5EFA\u3002\u4F60\u53D1\u73B0\u6CA1\uFF0C\u4F20\u7EDF\u5EFA\u9020\u6E38\u620F\u91CC\u57CE\u5E02\u662F\u6B7B\u7269\uFF0C\u4F60\u94FA\u8DEF\u5212\u533A\u5EFA\u697C\uFF0C\u5B83\u914D\u5408\u4F60\u3002\u8FD9\u6E38\u620F\u53CD\u7740\u6765\uFF0C\u4F60\u653E\u5EFA\u7B51\uFF0C\u57CE\u5E02\u53EF\u80FD\u641E\u7834\u574F\uFF0C\u8BA9\u4EA4\u901A\u762B\u75EA\u3001\u8D44\u6E90\u77ED\u7F3A\uFF0C\u751A\u81F3\u62C6\u4F60\u7684\u4E1C\u897F\u3002\u8BF4\u6765\u6709\u8DA3\uFF0C\u73A9\u5BB6\u5F97\u8DDF\u57CE\u5E02\u6597\u667A\u6597\u52C7\uFF0C\u4E00\u8FB9\u89C4\u5212\u4E00\u8FB9\u5E94\u5BF9\u6076\u610F\u3002\u6838\u5FC3\u4EF7\u503C\u662F\u628A\u5EFA\u9020\u53D8\u6210\u5BF9\u6297\u4F53\u9A8C\uFF0C\u4E0D\u662F\u5355\u7EAF\u6C99\u76D2\uFF0C\u800C\u662F\u6709\u538B\u529B\u7684\u7B56\u7565\u535A\u5F08\u3002\u8BBE\u8BA1\u601D\u8DEF\u5F88\u65B0\u9C9C\u3002",
      "Suitability": "\u9002\u5408\u559C\u6B22\u7B56\u7565\u5BF9\u6297\u3001\u538C\u5026\u4F20\u7EDF\u6C99\u76D2\u5EFA\u9020\u7684\u73A9\u5BB6\uFF0C\u4EE5\u53CA\u60F3\u4F53\u9A8C\u65B0\u9896\u6E38\u620F\u673A\u5236\u7684\u5F00\u53D1\u8005\u3002",
      "Score": 8
    },
