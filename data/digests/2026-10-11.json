      "Highlight": {
        "Text": "\u4ECE\u6982\u7387\u4F30\u8BA1\u5230\u6548\u7528\u51FD\u6570\uFF0C\u624B\u628A\u624B\u6559\u4F60\u642D\u4E00\u4E2A\u80FD\u7B97\u7684\u51B3\u7B56\u6A21\u578B\uFF0C\u5B9E\u7528\u4E0D\u98D8\u3002"
      },
      "Description": "\u8FD9\u5176\u5B9E\u662F\u4E00\u7BC7\u6559\u4F60\u4ECE\u96F6\u6784\u5EFA\u51B3\u7B56\u6A21\u578B\u7684\u6559\u7A0B\u3002\u4F60\u53D1\u73B0\u6CA1\uFF0C\u5F88\u591A\u51B3\u7B56\u5206\u6790\u6587\u7AE0\u53EA\u8BB2\u6982\u5FF5\uFF0C\u8FD9\u7BC7\u76F4\u63A5\u8BA9\u4F60\u52A8\u624B\u5B9E\u73B0\uFF0C\u4ECE\u6982\u7387\u4F30\u8BA1\u3001\u6548\u7528\u51FD\u6570\u5230\u6811\u7ED3\u6784\u9009\u62E9\uFF0C\u4E00\u6B65\u6B65\u628A\u51B3\u7B56\u8FC7\u7A0B\u53D8\u6210\u53EF\u8BA1\u7B97\u7684\u4E1C\u897F\u3002\u5B83\u4E0D\u8FFD\u590D\u6742\u7B97\u6CD5\uFF0C\u800C\u662F\u628A Decision Theory \u91CC\u6700\u6838\u5FC3\u7684\u51E0\u5757\u62C6\u5F00\uFF0C\u8BA9\u4F60\u7406\u89E3\u6BCF\u4E00\u6B65\u4E3A\u4EC0\u4E48\u8FD9\u4E48\u505A\u3002\u9002\u5408\u60F3\u7ED9\u4EA7\u54C1\u52A0\u89C4\u5219\u5F15\u64CE\uFF0C\u6216\u8005\u9700\u8981\u505A\u98CE\u9669\u8BC4\u4F30\u7684\u5DE5\u7A0B\u5E08\u3002\u8BFB\u4E0B\u6765\u4E0D\u7D2F\uFF0C\u4F46\u80FD\u5EFA\u7ACB\u4E00\u5957\u81EA\u5DF1\u53EF\u590D\u7528\u7684\u51B3\u7B56\u5EFA\u6A21\u601D\u8DEF\u3002",
      "Suitability": "\u9002\u5408\u60F3\u7406\u89E3\u51B3\u7B56\u5206\u6790\u3001\u642D\u5EFA\u7B80\u5355\u51B3\u7B56\u652F\u6301\u6216\u98CE\u9669\u8BC4\u4F30\u539F\u578B\u7684\u573A\u666F\uFF0C\u6BD4\u5982\u63A8\u8350\u6392\u5E8F\u3001\u98CE\u63A7\u521D\u7B5B\u3001\u4E1A\u52A1\u89C4\u5219\u5F15\u64CE\u3002",
      "Score": 6
    },
