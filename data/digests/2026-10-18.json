      },
      "Description": "\u8FD9\u7BC7\u62A5\u9053\u8BB2\u7684\u662F\u7F8E\u56FD\u4E1C\u5317\u90E8\u4E00\u6279\u8001\u65E7\u6C34\u575D\u62C6\u9664\u540E\uFF0C\u9CB1\u9C7C\u3001\u9CA5\u9C7C\u8FD9\u4E9B\u6D04\u6E38\u9C7C\u7C7B\u91CD\u65B0\u6E38\u56DE\u4E0A\u6E38\u4EA7\u5375\uFF0C\u6709\u4E9B\u6CB3\u6BB5\u6570\u91CF\u51E0\u5E74\u5185\u7FFB\u4E86\u597D\u51E0\u500D\u3002\u4F60\u53D1\u73B0\u6CA1\uFF0C\u4E4B\u524D\u5F88\u591A\u4EBA\u62C5\u5FC3\u62C6\u575D\u4F1A\u7834\u574F\u751F\u6001\uFF0C\u4F46\u5B9E\u9645\u6570\u636E\u53CD\u800C\u8BC1\u660E\u6CB3\u6D41\u8FDE\u901A\u6027\u4E00\u6062\u590D\uFF0C\u9C7C\u7FA4\u81EA\u5DF1\u5C31\u627E\u56DE\u6765\u4E86\u3002\u5176\u5B9E\u6838\u5FC3\u4EF7\u503C\u5728\u4E8E\u5B83\u63D0\u4F9B\u4E86\u5927\u89C4\u6A21\u3001\u8DE8\u6D41\u57DF\u7684\u5B9E\u8BC1\u6848\u4F8B\uFF0C\u7ED9\u5168\u7403\u90A3\u4E9B\u7EA0\u7ED3\u8981\u4E0D\u8981\u62C6\u8001\u575D\u7684\u5730\u65B9\u4E00\u4E2A\u5F88\u786C\u7684\u53C2\u8003\u3002\u8BF4\u6765\u6709\u8DA3\uFF0C\u5F88\u591A\u76D1\u6D4B\u624B\u6BB5\u5E76\u4E0D\u590D\u6742\uFF0C\u5C31\u662F\u5E38\u89C4\u7684\u9C7C\u7C7B\u8BA1\u6570\u548CeDNA\u91C7\u6837\uFF0C\u4F46\u628A\u65F6\u95F4\u7EBF\u62C9\u957F\u4E00\u770B\uFF0C\u8D8B\u52BF\u7279\u522B\u6E05\u695A\u3002",
      "Suitability": "\u9002\u5408\u6C34\u5229\u653F\u7B56\u5236\u5B9A\u8005\u3001\u751F\u6001\u4FEE\u590D\u56E2\u961F\u3001\u73AF\u4FDD\u673A\u6784\u505A\u62C6\u575D\u51B3\u7B56\u6216\u516C\u4F17\u6C9F\u901A\u65F6\u5F15\u7528\uFF0C\u4E5F\u9002\u5408\u4F5C\u4E3A\u6CB3\u6D41\u751F\u6001\u6062\u590D\u7684\u6848\u4F8B\u6559\u5B66\u6750\u6599",
