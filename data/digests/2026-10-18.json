      "Description": "Furifont \u662F\u4E2A\u65E5\u8BED\u5B57\u4F53\uFF0C\u4E13\u95E8\u89E3\u51B3\u6C49\u5B57\u8BFB\u97F3\u95EE\u9898\u3002\u4F60\u6253\u5F00\u5B57\u4F53\u91CC\u7684 ruby \u7279\u6027\uFF0C\u6C49\u5B57\u4E0A\u65B9\u5C31\u4F1A\u81EA\u52A8\u51FA\u73B0\u5C0F\u53F7\u5047\u540D\u6CE8\u97F3\uFF0C\u4E0D\u7528\u624B\u52A8\u6807\u6CE8\u3002\u5176\u5B9E\u5F88\u591A\u65E5\u8BED\u5B66\u4E60\u8005\u770B\u5230\u6EE1\u7BC7\u6C49\u5B57\u5C31\u5934\u5927\uFF0C\u8FD9\u4E2A\u5B57\u4F53\u628A\u8BFB\u97F3\u76F4\u63A5\u5D4C\u5728\u5B57\u5F62\u91CC\uFF0C\u9009\u4E2A\u5B57\u4F53\u5C31\u80FD\u8BFB\u3002\u4F60\u53D1\u73B0\u6CA1\uFF0C\u5B83\u4E0D\u50CF\u666E\u901A\u6CE8\u97F3\u9700\u8981\u989D\u5916\u6807\u7B7E\u6216\u811A\u672C\uFF0C\u7EAF\u9760\u5B57\u4F53\u81EA\u8EAB\u7279\u6027\u5B9E\u73B0\uFF0C\u6240\u4EE5\u4EFB\u4F55\u652F\u6301 OpenType \u7684\u8F6F\u4EF6\u90FD\u80FD\u7528\u3002\u6838\u5FC3\u4EF7\u503C\u5C31\u662F\u964D\u4F4E\u9605\u8BFB\u95E8\u69DB\uFF0C\u5BF9\u5B66\u65E5\u8BED\u7684\u4EBA\u7279\u522B\u53CB\u597D\u3002",
      "Suitability": "\u65E5\u8BED\u5B66\u4E60\u3001\u9605\u8BFB\u65E5\u6587\u8D44\u6599\u3001\u6559\u6750\u6392\u7248\u3001\u7535\u5B50\u4E66\u9605\u8BFB\u7B49\uFF0C\u5C24\u5176\u9002\u5408\u9700\u8981\u9891\u7E41\u67E5\u5047\u540D\u7684\u521D\u5B66\u8005",
