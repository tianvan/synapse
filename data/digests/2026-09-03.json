        "Text": "\u6700\u5927\u6697\u7269\u8D28\u63A2\u6D4B\u5668\u7F55\u89C1\u6355\u6349\u5230\u5355\u4E2A\u5F02\u5E38\u7C92\u5B50\u4FE1\u53F7\uFF0C\u53EF\u80FD\u6765\u81EA\u592A\u9633\u4E2D\u5FAE\u5B50\uFF0C\u6311\u6218\u672C\u5E95\u6A21\u578B\u3002"
      },
      "Description": "\u6700\u5927\u6697\u7269\u8D28\u63A2\u6D4B\u5668\u672C\u6765\u5728\u7B49\u6697\u7269\u8D28\uFF0C\u7ED3\u679C\u649E\u89C1\u4E00\u4E2A\u5355\u72EC\u7684\u53CD\u5E38\u7C92\u5B50\u3002\u4F60\u53D1\u73B0\u6CA1\uFF0C\u8FD9\u79CD\u4FE1\u53F7\u6781\u96BE\u6293\u5230\uFF0C\u672C\u5E95\u5FC5\u987B\u538B\u5230\u6781\u4F4E\u3002\u5B83\u5F88\u53EF\u80FD\u662F\u592A\u9633\u4E2D\u5FAE\u5B50\uFF0C\u901A\u8FC7\u76F8\u5E72\u6563\u5C04\u7559\u4E0B\u5FAE\u5F31\u53CD\u51B2\u3002\u8BF4\u6765\u6709\u8DA3\uFF0C\u6697\u7269\u8D28\u6CA1\u627E\u5230\uFF0C\u53CD\u800C\u5148\u6478\u5230\u4E2D\u5FAE\u5B50\u80CC\u666F\u3002\u8FD9\u610F\u5473\u7740\u7075\u654F\u5EA6\u5230\u65B0\u53F0\u9636\uFF0C\u540E\u7EED\u5F97\u8BC6\u522B\u8FD9\u4E2A\u201C\u4E2D\u5FAE\u5B50\u96FE\u201D\u3002\u6838\u5FC3\u4EF7\u503C\u662F\u7ED9\u6697\u7269\u8D28\u63A2\u6D4B\u5212\u51FA\u65B0\u95E8\u69DB\u3002",
      "Suitability": "\u9002\u5408\u5173\u6CE8\u6697\u7269\u8D28\u76F4\u63A5\u63A2\u6D4B\u3001\u4E2D\u5FAE\u5B50\u7269\u7406\u548C\u7C92\u5B50\u5B9E\u9A8C\u672C\u5E95\u6311\u6218\u7684\u8BFB\u8005\uFF0C\u4E5F\u9002\u5408\u505A\u6DB2\u6C19\u63A2\u6D4B\u5668\u6570\u636E\u5206\u6790\u7684\u4EBA\u4E86\u89E3\u524D\u6CBF\u7075\u654F\u5EA6\u3002",
